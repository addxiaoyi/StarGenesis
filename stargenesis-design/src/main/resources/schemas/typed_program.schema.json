{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stargenesis:typed-program:1",
  "title": "StarGenesis typed program schema 1",
  "type": "object",
  "properties": {
    "kind": { "const": "TYPED_PROGRAM" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]{0,31}:[a-z0-9][a-z0-9_./-]{0,94}$",
      "not": { "pattern": "\\.\\.|/$" }
    },
    "author": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "maxInstructionsPerStep": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_:-]{0,63}$" },
          "operation": {
            "type": "string",
            "enum": [
              "CONSTANT_BOOLEAN", "CONSTANT_INTEGER", "SENSE_BOOLEAN", "SENSE_INTEGER",
              "SENSE_VECTOR", "SENSE_RESOURCE", "ADD_INTEGER", "SUBTRACT_INTEGER",
              "MULTIPLY_INTEGER", "DIVIDE_INTEGER", "MINIMUM_INTEGER", "MAXIMUM_INTEGER",
              "CLAMP_INTEGER", "EQUAL_INTEGER", "COMPARE_THRESHOLD_INTEGER", "LESS_THAN_INTEGER",
              "GREATER_THAN_INTEGER", "AND_BOOLEAN", "OR_BOOLEAN", "NOT_BOOLEAN", "XOR_BOOLEAN",
              "SELECT_INTEGER", "MAKE_VECTOR", "VECTOR_X", "VECTOR_Y", "VECTOR_Z",
              "DISTANCE_SQUARED", "HAS_RESOURCE", "MOVE", "HARVEST", "DEPOSIT", "WAIT",
              "EMIT_SIGNAL", "READ_SIGNAL", "RANDOM_INTEGER"
            ]
          },
          "inputs": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_:-]{0,63}$" }
          },
          "parameters": {
            "type": "object",
            "maxProperties": 4,
            "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_:-]{0,63}$" },
            "additionalProperties": { "type": "string", "maxLength": 128, "pattern": "^[^\\x00-\\x1f]*$" }
          }
        },
        "required": [ "id", "operation", "inputs", "parameters" ],
        "additionalProperties": false
      }
    }
  },
  "required": [ "kind", "schemaVersion", "id", "author", "hash", "maxInstructionsPerStep", "instructions" ],
  "additionalProperties": false
}
