  "rules": {
    "commandQueueCapacity": 128,
    "connectionIdentity": "A fresh object for each join. Deferred callbacks and queued commands capture the original connection; invitations capture both parties.",
    "fullQueue": "Quit updates the volatile immutable connection snapshot even if the coalesced sweep cannot be queued. Every command reconciles before/after execution.",
    "idleQueue": "A coalesced worker sweep retires temporary state without requiring another player command.",
    "stateOwnership": "Selections and Factory invitations are mutated only by the storage worker. Connection events do not wait on service disk calls.",
    "lateCompletion": "Already-admitted persistent operations may finish. Finally cleanup removes late transient selections/invitations from retired connections.",
    "memory": "Current and previously applied snapshots retain only their online connection sets; 10000-identity churn leaves both empty after cleanup. No disconnected UUID journal.",
    "shutdown": "Player command admission closes before worker shutdown. Not-yet-started player commands are skipped; actual worker termination still owns directory release.",
    "format": "No change to stored organizations, teams, pending actions, spectators, replay schemas, hashes or simulation semantics."
  },
  "limitations": [
    "No new Paper/Folia, live queue saturation, region concurrency, hot reload, production load or human acceptance evidence.",
    "Latch-controlled admitted operations pause before real service calls; these tests do not inject live disk interruptions.",
    "Transient cleanup waits for the worker to make progress; connection retirement and stale-command rejection are recorded immediately.",
    "Snapshots scale with concurrent online players. No new server player-count limit or general performance claim.",
    "Already-running successful writes may persist after disconnect/close. Commands which never started are not durable and require a fresh user request.",
    "Arena synchronous draft cleanup retains its separate lifecycle; match connections are retired before waiting for draft cleanup.",
    "Real providers, operator trust roots, third-party acceptance and final release signatures remain incomplete."
  ],
