* text=auto
*.java text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.mjs text eol=lf
mvnw text eol=lf
*.cmd text eol=crlf
# Raw evidence must preserve bytes and hashes across Windows/Linux checkout.
docs/evidence/**/*.log -text -diff
docs/evidence/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/evidence/**/*.xml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
