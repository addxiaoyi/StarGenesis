+    private void destroyRetainingFailure(ModelInstanceImpl inst) {
+        pendingVisualCleanup.put(inst.instanceId(), inst);
+        inst.despawn();
+        pendingVisualCleanup.remove(inst.instanceId(), inst);
+    }
+
+    /** Retry only visual teardown; removal events and caller-owned entities are not replayed. */
+    public void retryPendingVisualCleanup() {
+        RuntimeException failure = null;
+        for (ModelInstanceImpl inst : java.util.List.copyOf(pendingVisualCleanup.values())) {
+            try { destroyRetainingFailure(inst); }
+            catch (RuntimeException next) {
+                if (failure == null) failure = next;
+                else if (failure != next) failure.addSuppressed(next);
+            }
+        }
+        if (failure != null) throw failure;
+    }
+
