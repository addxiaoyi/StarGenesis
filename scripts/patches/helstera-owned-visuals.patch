@@ -0,0 +1,225 @@
+package dev.helstera.render.display;
+
+import dev.helstera.api.Vec3;
+import dev.helstera.api.instance.SpawnOptions;
+import dev.helstera.core.model.ModelDefinitionImpl;
+import dev.helstera.runtime.instance.ModelInstanceImpl;
+import org.bukkit.Location;
+import org.bukkit.World;
+import org.bukkit.entity.*;
+import org.bukkit.persistence.PersistentDataContainer;
+import org.bukkit.plugin.Plugin;
+import org.junit.jupiter.api.Test;
+
+import java.util.*;
+import java.util.function.Consumer;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+class DisplayRendererFailureTest {
+    private final Plugin plugin = mock(Plugin.class);
+    private final World world = mock(World.class);
+    private final BoneCommandMapping mapping = mock(BoneCommandMapping.class);
+    private final DisplayRenderer renderer = new DisplayRenderer(plugin, mapping);
+    private final ModelInstanceImpl instance = mock(ModelInstanceImpl.class);
+    private final ModelDefinitionImpl model = mock(ModelDefinitionImpl.class);
+    private final Location at = new Location(world, 1, 2, 3);
+    private final List<Entity> spawned = new ArrayList<>();
+    private Runnable duringSpawn = () -> {};
+
+    @SuppressWarnings("unchecked")
+    private void setup(int failAt, boolean failAfterCallback) {
+        when(plugin.getName()).thenReturn("helsteraMobs");
+        when(instance.instanceId()).thenReturn(17);
+        when(instance.modelImpl()).thenReturn(model);
+        when(instance.location()).thenReturn(at);
+        when(instance.baseEntity()).thenReturn(Optional.empty());
+        when(instance.getScale()).thenReturn(1d);
+        when(model.id()).thenReturn("probe");
+        when(model.hitbox()).thenReturn(new dev.helstera.api.model.ModelHitbox(1, 1));
+        var bone = new ModelDefinitionImpl.BoneImpl("body", null, Vec3.ZERO, Vec3.ZERO, List.of(), Map.of(), null, null);
+        when(model.allBones()).thenReturn(List.of(bone));
+        when(model.bone("body")).thenReturn(bone);
+        when(world.spawn(any(Location.class), any(Class.class), any(Consumer.class))).thenAnswer(call -> {
+            Entity entity = mock((Class<? extends Entity>) call.getArgument(1));
+            when(entity.getUniqueId()).thenReturn(UUID.randomUUID());
+            when(entity.getPersistentDataContainer()).thenReturn(mock(PersistentDataContainer.class));
+            spawned.add(entity);
+            if (spawned.size() == failAt && !failAfterCallback) {
+                if (entity instanceof ArmorStand stand) doThrow(new IllegalStateException("initializer")).when(stand).setInvisible(true);
+                else if (entity instanceof ItemDisplay display) doThrow(new IllegalStateException("initializer")).when(display).setItemStack(any());
+                else if (entity instanceof Interaction hitbox) doThrow(new IllegalStateException("initializer")).when(hitbox).setInteractionWidth(anyFloat());
+                else if (entity instanceof TextDisplay tag) doThrow(new IllegalStateException("initializer")).when(tag).text(any());
+            }
+            ((Consumer<Entity>) call.getArgument(2)).accept(entity);
+            duringSpawn.run();
+            if (spawned.size() == failAt && failAfterCallback) throw new IllegalStateException("after initializer");
+            return entity;
+        });
+    }
+    private SpawnOptions options() { return SpawnOptions.defaults().showName(true).displayName("Probe"); }
+
+    @Test void everyInitializerFailureRetainsAllCreatedObjectsForCleanup() {
+        // Separate renderer per injection keeps partial ownership checks independent.
+        for (int index = 1; index <= 4; index++) {
+            var fixture = new DisplayRendererFailureTest();
+            fixture.setup(index, false);
+            assertThrows(IllegalStateException.class, () -> fixture.renderer.createVisuals(fixture.instance, fixture.at, fixture.options()));
+            fixture.renderer.destroyVisuals(fixture.instance);
+            fixture.renderer.destroyVisuals(fixture.instance);
+            for (Entity entity : fixture.spawned) verify(entity).remove();
+            assertEquals(0, fixture.renderer.renderedEntityCount(17));
+        }
+    }
+
+    @Test void failuresAfterSpawnCallbackStillRetainOwnership() {
+        setup(2, true);
+        assertThrows(IllegalStateException.class, () -> renderer.createVisuals(instance, at, options()));
+        renderer.destroyVisuals(instance);
+        for (Entity entity : spawned) verify(entity).remove();
+    }
+
+    @Test void failedRemovalAttemptsEveryObjectAndRetainsOnlyFailuresForRetry() {
+        setup(0, false);
+        renderer.createVisuals(instance, at, options());
+        doThrow(new IllegalStateException("remove")).doNothing().when(spawned.get(1)).remove();
+        assertThrows(IllegalStateException.class, () -> renderer.destroyVisuals(instance));
+        for (Entity entity : spawned) verify(entity).remove();
+        assertEquals(1, renderer.renderedEntityCount(17));
+        assertEquals(17, renderer.instanceOf(spawned.get(1)));
+        renderer.destroyVisuals(instance);
+        renderer.destroyVisuals(instance);
+        for (int index = 0; index < spawned.size(); index++) verify(spawned.get(index), times(index == 1 ? 2 : 1)).remove();
+        for (Entity entity : spawned) assertNull(renderer.instanceOf(entity));
+        assertEquals(0, renderer.renderedEntityCount(17));
+    }
+
+    @Test void duplicateCreateCannotOverwriteOwnedVisuals() {
+        setup(0, false);
+        renderer.createVisuals(instance, at, options());
+        assertThrows(IllegalStateException.class, () -> renderer.createVisuals(instance, at, options()));
+        assertEquals(4, spawned.size());
+        renderer.destroyVisuals(instance);
+        for (Entity entity : spawned) verify(entity).remove();
+    }
+
+    @Test void shutdownFailureStillAttemptsOtherEntitiesAndCanBeRetried() {
+        setup(0, false);
+        renderer.createVisuals(instance, at, options());
+        doThrow(new IllegalStateException("remove")).doNothing().when(spawned.getFirst()).remove();
+        assertThrows(IllegalStateException.class, renderer::shutdown);
+        for (Entity entity : spawned) verify(entity).remove();
+        renderer.shutdown();
+        renderer.shutdown();
+        verify(spawned.getFirst(), times(2)).remove();
+        assertEquals(0, renderer.renderedEntityCount(17));
+    }
+
+    @Test void displayOnlyCarrierHonorsPassiveOptionsAndDoesNotCreateHitbox() {
+        setup(0, false);
+        renderer.createVisuals(instance, at, SpawnOptions.defaults().persistent(false).spawnHitbox(false)
+                .collidable(false).invulnerable(true).silent(true));
+        assertTrue(renderer.supportsOwnedVisualCleanup());
+        assertEquals(2, spawned.size());
+        var carrier = (ArmorStand) spawned.getFirst();
+        verify(carrier).setMarker(true);
+        verify(carrier).setInvulnerable(true);
+        verify(carrier).setCollidable(false);
+        verify(carrier).setPersistent(false);
+        verify(carrier).setGravity(false);
+        verify(carrier).setCanPickupItems(false);
+        renderer.destroyVisuals(instance);
+    }
+
