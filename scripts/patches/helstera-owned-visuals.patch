+package dev.helstera.runtime.instance;
+
+import dev.helstera.api.event.HelsteraEventBus;
+import dev.helstera.api.event.ModelRemoveEvent;
+import dev.helstera.api.instance.SpawnOptions;
+import dev.helstera.api.instance.ModelCreationException;
+import dev.helstera.api.model.ModelHitbox;
+import dev.helstera.api.model.ModelRegistry;
+import dev.helstera.core.model.ModelDefinitionImpl;
+import org.bukkit.Location;
+import org.bukkit.entity.Player;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.nio.file.Path;
+import java.util.Collection;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class InstanceCreationRollbackTest {
+    private static final class Renderer implements InstanceRenderer {
+        ModelInstanceImpl observed;
+        Runnable duringCreate = () -> {};
+        boolean failCreate, failTransform;
+        int destroyFailures, destroys;
+        SpawnOptions options;
+        public void createVisuals(ModelInstanceImpl inst, Location at, SpawnOptions options) {
+            observed = inst;
+            this.options = options;
+            duringCreate.run();
+            if (failCreate) throw new IllegalStateException("create");
+        }
+        public void updateTransforms(ModelInstanceImpl inst) {
+            if (failTransform) throw new IllegalStateException("transform");
+        }
+        public void updateLocation(ModelInstanceImpl inst) {}
+        public void updateAttachments(ModelInstanceImpl inst) {}
+        public void destroyVisuals(ModelInstanceImpl inst) {
+            destroys++;
+            if (destroyFailures-- > 0) throw new IllegalStateException("destroy");
+        }
+        public void applyVisibility(ModelInstanceImpl inst, Collection<Player> visible, Collection<Player> hidden) {}
+    }
+    private final Renderer renderer = new Renderer();
+    private final HelsteraEventBus bus = new HelsteraEventBus();
+    private final ModelDefinitionImpl model = new ModelDefinitionImpl("probe", "Probe", "1", "test", 1,
+            null, List.of(), new ModelHitbox(1, 1), Path.of("."), "fixture", Map.of(), List.of());
+    private final ModelRegistry registry = (ModelRegistry) Proxy.newProxyInstance(ModelRegistry.class.getClassLoader(),
+            new Class<?>[]{ModelRegistry.class}, (proxy, method, args) -> {
+                if (method.getName().equals("get")) return Optional.of(model);
+                throw new AssertionError(method.getName());
+            });
+    private final InstanceManagerImpl manager = new InstanceManagerImpl(registry, bus, renderer, null);
+
+    @Test void partialCreationIsNeverPublished() {
+        renderer.duringCreate = () -> {
+            assertEquals(0, manager.activeCount());
+            assertTrue(manager.getInstance(renderer.observed.instanceId()).isEmpty());
+        };
+        var result = manager.spawn("probe", new Location(null, 1, 2, 3), SpawnOptions.defaults());
+        assertSame(result, manager.getInstance(result.instanceId()).orElseThrow());
+    }
+
+    @Test void createFailureInvalidatesAndCleansWithoutRemoveEvent() {
+        AtomicInteger events = new AtomicInteger();
+        bus.register(ModelRemoveEvent.class, ignored -> events.incrementAndGet());
+        renderer.failCreate = true;
+        assertThrows(RuntimeException.class, () -> manager.spawn("probe", new Location(null, 0, 0, 0), null));
+        assertEquals(0, manager.activeCount());
+        assertFalse(renderer.observed.isValid());
+        assertEquals(1, renderer.destroys);
+        assertEquals(0, events.get());
+    }
+
+    @Test void transformFailureRollsBackAlreadyCreatedVisuals() {
+        renderer.failTransform = true;
+        assertThrows(RuntimeException.class, () -> manager.spawn("probe", new Location(null, 0, 0, 0), null));
+        assertEquals(0, manager.activeCount());
+        assertFalse(renderer.observed.isValid());
+        assertEquals(1, renderer.destroys);
+    }
+
+    @Test void nullOptionsAreNormalizedBeforeCallingRenderer() {
+        var instance = manager.spawn("probe", new Location(null, 0, 0, 0), null);
+        assertSame(((ModelInstanceImpl) instance).options(), renderer.options);
+        assertNotNull(renderer.options);
+    }
+
+    @Test void despawnCanRetryAfterFailureAndIsIdempotentAfterSuccess() {
+        var instance = manager.spawn("probe", new Location(null, 0, 0, 0), null);
+        renderer.destroyFailures = 1;
+        assertThrows(IllegalStateException.class, instance::despawn);
+        assertFalse(instance.isValid());
+        instance.despawn();
+        instance.despawn();
+        assertEquals(2, renderer.destroys);
+    }
+
+    @Test void invalidCleanupRetriesRatherThanLosingRendererOwnership() {
+        var instance = manager.spawn("probe", new Location(null, 0, 0, 0), null);
+        renderer.destroyFailures = 1;
+        assertThrows(IllegalStateException.class, instance::despawn);
+        manager.cleanupInvalid();
+        assertEquals(2, renderer.destroys);
+        assertEquals(0, manager.activeCount());
+    }
+
+    @Test void invalidLocationDoesNotPublishAnInstance() {
+        assertThrows(RuntimeException.class, () -> manager.spawn("probe", null, null));
+        assertEquals(0, manager.activeCount());
+    }
+
+    @Test void creationFailureExposesInvalidRetryableHandleAndPreservesBothFailures() {
+        renderer.failCreate = true;
+        renderer.destroyFailures = 2;
+        var failure = assertThrows(ModelCreationException.class,
+                () -> manager.spawn("probe", new Location(null, 0, 0, 0), null));
+        assertSame(renderer.observed, failure.cleanupHandle());
+        assertEquals("create", failure.getCause().getMessage());
+        assertEquals("destroy", failure.getCause().getSuppressed()[0].getMessage());
+        assertEquals(0, manager.activeCount());
+        assertFalse(failure.cleanupHandle().isValid());
+        assertEquals(1, manager.pendingVisualCleanupCount());
+        assertThrows(IllegalStateException.class, failure.cleanupHandle()::despawn);
+        failure.cleanupHandle().despawn();
+        manager.retryPendingVisualCleanup();
+        assertEquals(0, manager.pendingVisualCleanupCount());
+        assertEquals(3, renderer.destroys);
+    }
+
+    @Test void managerRemovalCanBeRetriedByIdWithoutRepeatingEvents() {
+        AtomicInteger events = new AtomicInteger();
+        bus.register(ModelRemoveEvent.class, ignored -> events.incrementAndGet());
+        var instance = manager.spawn("probe", new Location(null, 0, 0, 0), null);
+        renderer.destroyFailures = 1;
+        assertThrows(IllegalStateException.class, () -> manager.despawn(instance.instanceId()));
+        assertEquals(0, manager.activeCount());
+        assertTrue(manager.despawn(instance.instanceId()));
+        assertFalse(manager.despawn(instance.instanceId()));
+        assertEquals(1, events.get());
+        assertEquals(2, renderer.destroys);
+    }
+
+    @Test void alternativeRendererDoesNotImplicitlyAdvertiseCleanupGuarantees() {
+        assertFalse(manager.supportsOwnedVisualCleanup());
+    }
+
+    @Test void passiveProjectionDoesNotStartIdleOrInstallAutomaticAnimationStateMachine() {
+        var animated = new ModelDefinitionImpl("probe", "Probe", "1", "test", 1,
+                "idle", List.of(), new ModelHitbox(1, 1), Path.of("."), "fixture",
+                Map.of("idle", new dev.helstera.core.animation.AnimationClip("idle", true, 1, Map.of(), List.of())), List.of());
+        var models = (ModelRegistry) Proxy.newProxyInstance(ModelRegistry.class.getClassLoader(),
+                new Class<?>[]{ModelRegistry.class}, (proxy, method, args) -> Optional.of(animated));
+        var instances = new InstanceManagerImpl(models, bus, renderer, null);
+        var ordinary = (ModelInstanceImpl) instances.spawn("probe", new Location(null, 0, 0, 0), null);
+        assertEquals(Optional.of("idle"), ordinary.animation().currentAnimation());
+        assertNotNull(ordinary.stateMachine);
+        var passive = (ModelInstanceImpl) instances.spawn("probe", new Location(null, 0, 0, 0),
+                SpawnOptions.defaults().automaticAnimation(false));
+        assertTrue(passive.animation().currentAnimation().isEmpty());
+        assertNull(passive.stateMachine);
+    }
+}
