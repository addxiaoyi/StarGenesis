@@ -0,0 +1,22 @@
+package dev.helstera.api.instance;
+
+import java.util.Objects;
+
+/**
+ * Creation failed after allocating an instance. The instance is invalid and is not
+ * published in the active registry. Its cleanup handle must be retained until
+ * {@link ModelInstance#despawn()} returns normally; failed cleanup can be retried
+ * on the main thread. The original failure is the cause, with rollback failures
+ * suppressed on it. This does not roll back changes to a caller-owned bound entity.
+ */
+public final class ModelCreationException extends IllegalStateException {
+    private static final long serialVersionUID = 1L;
+    private final ModelInstance cleanupHandle;
+
+    public ModelCreationException(ModelInstance cleanupHandle, RuntimeException cause) {
+        super("Model creation failed: " + cleanupHandle.instanceId(), Objects.requireNonNull(cause));
+        this.cleanupHandle = Objects.requireNonNull(cleanupHandle);
+    }
+
+    public ModelInstance cleanupHandle() { return cleanupHandle; }
+}
