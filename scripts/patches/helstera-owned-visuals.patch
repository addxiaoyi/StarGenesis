+    private void rollbackCreation(ModelInstanceImpl inst, Throwable failure) {
+        instances.remove(inst.instanceId(), inst);
+        try { destroyRetainingFailure(inst); }
+        catch (RuntimeException | Error cleanup) { if (cleanup != failure) failure.addSuppressed(cleanup); }
+    }
